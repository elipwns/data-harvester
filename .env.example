AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-west-2
S3_BUCKET_NAME=automated-trading-data-bucket

# Reddit API Configuration
# Create app at https://www.reddit.com/prefs/apps (script type)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=TradingBot/1.0

# FRED API - free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key

# Bluesky - app password from https://bsky.app/settings/app-passwords
BLUESKY_USERNAME=yourhandle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Polygon.io - free key at https://polygon.io/dashboard/signup
POLYGON_API_KEY=your_polygon_api_key

# Alerts
ALERT_EMAIL=your_email@example.com
